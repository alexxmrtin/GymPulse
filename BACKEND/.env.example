# Copia este archivo a .env y pon tus propios valores. El .env no se sube a git.
# Genera el secreto con:  openssl rand -base64 48
# Minimo 32 caracteres: HS256 exige una clave de 256 bits.
JWT_SECRETO=

# Credenciales del PostgreSQL local (docker-compose.yml las usa para crear la base, y el backend
# para conectarse). Pon la contrasena que quieras.
POSTGRES_USUARIO=gympulse
POSTGRES_CONTRASENA=
