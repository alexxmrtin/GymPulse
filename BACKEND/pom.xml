<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.gympulse</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>GymPulseBackend</name>
	<description>API REST de GymPulse</description>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<!-- Lo unico imprescindible: servidor web + capacidad de responder peticiones HTTP.
		     Iremos anadiendo starters de uno en uno segun los vayamos necesitando:
		     base de datos (data-jpa + postgresql), validacion, seguridad... -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Reinicia la aplicacion sola al guardar un archivo. Solo en desarrollo. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- JPA: el ORM que convierte clases Java en tablas de BD y viceversa. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- H2: base de datos embebida provisional. No necesita servidor ni configuracion.
		     Cuando migremos a PostgreSQL se quita esta dependencia y se añade la de PostgreSQL. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Spring Security. En cuanto esta en el classpath cierra TODOS los endpoints por
		     defecto: quien decide que se abre y que no es el SecurityFilterChain de SeguridadConfig. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Trae dos cosas: la libreria Nimbus para firmar y leer JWT (fase 2), y el soporte
		     para validarlos automaticamente en cada peticion (fase 3). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>

		<!-- Consola web de H2 para inspeccionar la BD. En Spring Boot 4 vive en su propio
		     modulo, ya no viene con el autoconfigure. Solo desarrollo. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-h2console</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Solo las utilidades de cifrado de Spring Security (BCrypt), no el starter completo:
		     el starter bloquearia todos los endpoints hasta configurar la autenticacion. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
